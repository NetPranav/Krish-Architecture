# ╔══════════════════════════════════════════════════════╗
# ║  SmartAgri · Environment Variables Template          ║
# ╚══════════════════════════════════════════════════════╝

# ── Roboflow Vision API (Leaf Disease + Soil Detection) ──
ROBOFLOW_API_KEY=your_roboflow_key_here

# ── OpenWeatherMap (Weather Data) ──
# Get your key at: https://home.openweathermap.org/api_keys
# Leave blank to use mock weather data
OPENWEATHER_API_KEY=

# ── NVIDIA NIM API (Mitra AI Brain) ──
# Get your free key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your_nvidia_key_here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
